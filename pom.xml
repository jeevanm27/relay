<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Spring Boot parent is used only for dependency/plugin version management.
       Only relay-server actually depends on Spring Boot starters. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.relay</groupId>
  <artifactId>relay-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>relay-parent</name>
  <description>Relay: a multi-tenant durable job queue on PostgreSQL (at-least-once delivery)</description>

  <modules>
    <module>relay-core</module>
    <module>relay-server</module>
    <module>relay-worker</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Testcontainers 1.21.4+ is required to talk to Docker Engine 29 (min API version 1.44). -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.relay</groupId>
        <artifactId>relay-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.relay</groupId>
        <artifactId>relay-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Concurrency tests are the point of this project: never run them in parallel with each other,
                 they already create the parallelism they need internally. -->
            <argLine>-Xmx768m -Duser.timezone=UTC</argLine>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
